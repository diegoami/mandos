+      handle: 1, kindKey: "kind:0", baseName: "food", carried: true, aware: true,
+      label: "food", nameColor: "white", tval: TV.FOOD, sval: 99, pval: 0, number: 2,
+      weight: 0, ac: 0, toA: 0, toH: 0, toD: 0, dd: 0, ds: 0, ego: false,
